# Normalizacion de fin de linea.
# Evita que un mismo archivo aparezca "modificado" solo por trabajar en
# sistemas distintos, o por el paso de un archivo entre las dos carpetas.
# En el repositorio siempre se guarda LF.

* text=auto eol=lf

*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
.env.example text eol=lf
.gitignore   text eol=lf

# Scripts de Windows: deben conservar CRLF o no ejecutan
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios: git no los toca
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.jar  binary
