# Copiar a .env y completar. El archivo .env NO se sube al repositorio (ARQ-03, SEG-02).

# ---------------------------------------------------------------------------
# OPCION A — Neon, PostgreSQL en la nube (es la que se demuestra)
# ---------------------------------------------------------------------------
# El host lo da el panel de Neon: ep-algo-123456.REGION.aws.neon.tech
# sslmode=require es obligatorio, Neon rechaza conexiones sin TLS.
DB_URL=jdbc:postgresql://HOST.neon.tech/finmind?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# OPCION B — PostgreSQL local con Docker (para desarrollar sin internet)
# ---------------------------------------------------------------------------
# DB_URL=jdbc:postgresql://localhost:5433/finmind
# DB_USERNAME=finmind_user
# DB_PASSWORD=finmind_local

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# OBLIGATORIA. Ya NO tiene valor por defecto: la aplicacion no arranca sin
# ella, y es a proposito (SEG-01, ADR-021). Antes habia un valor por defecto
# publicado en este repositorio, asi que cualquiera que lo leyera podia firmar
# un token para cualquier usuario, con rol ADMIN, sin adivinar contrasenas.
#
# Minimo 32 caracteres aleatorios. Generar con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# ---------------------------------------------------------------------------
# Cookie de sesion (SEG-08, ADR-018)
# ---------------------------------------------------------------------------
# La sesion viaja en una cookie HttpOnly, no en sessionStorage.
#
# FINMIND_COOKIE_SEGURA=true hace que la cookie viaje SOLO por HTTPS.
#
# LEER ESTO ANTES DE LA DEMOSTRACION:
# El perfil prod pone segura=true. Si se demuestra sobre http://localhost con
# el perfil prod activo, el navegador NO manda la cookie y NADIE PUEDE INICIAR
# SESION. No es un defecto: es la proteccion funcionando.
# Para demostrar en localhost con perfil prod, dejar esta variable en false
# aqui: las variables de entorno tienen prioridad sobre application-prod.yml.
FINMIND_COOKIE_SEGURA=false

# Atributo SameSite. Lax es la defensa contra CSRF y alcanza porque todos los
# endpoints que modifican datos son POST, PUT, PATCH o DELETE.
# NO poner Strict: con Strict el navegador no manda la cookie al volver de
# Google y el acceso con Google queda roto.
FINMIND_COOKIE_MISMOSITIO=Lax

# Con false la documentacion de la API exige token (SEG-07, DT-15).
# Se deja en true para que el instructor pueda probar la API sin credenciales.
FINMIND_SWAGGER_PUBLICO=true

# ---------------------------------------------------------------------------
# Correo saliente — codigos de verificacion y recuperacion (RF-025 a RF-028)
# ---------------------------------------------------------------------------
# MAIL_ENABLED=false envia el codigo AL LOG en vez de por correo. Sirve para
# demostrar el flujo sin depender del servidor de correo, y para eso hay que
# leerlo con:  docker logs -f finmind-api
#
# Para que el correo salga de verdad, ponerlo en true y usar una CONTRASENA DE
# APLICACION de Gmail, no la contrasena de la cuenta:
#   1. La cuenta de Gmail necesita verificacion en dos pasos activada.
#   2. myaccount.google.com -> Seguridad -> Contrasenas de aplicaciones.
#   3. Crear una, copiar los 16 caracteres y pegarlos SIN ESPACIOS.
# Gmail muestra la clave como "abcd efgh ijkl mnop": van sin los espacios.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=
MAIL_FROM=FinMind <tu_correo@gmail.com>

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Origenes que el navegador puede usar para hablarle a la API. Nunca comodin:
# con allowCredentials en true —que hace falta para la cookie— el navegador
# PROHIBE el comodin, asi que es imposible dejarlo abierto por descuido.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Perfiles activos
# ---------------------------------------------------------------------------
# ACEPTA VARIOS, SEPARADOS POR COMA. Esto antes estaba mal explicado aqui: se
# decia "prod para la demostracion" en un sitio y "hay que poner google" en
# otro, como si fuera uno solo. Son perfiles distintos y se combinan.
#
#   (vacio)      desarrollo. Sin Google, con trazas y SQL en el log.
#   google       activa el inicio de sesion con Google.
#   prod         sin trazas ni SQL, Flyway con clean deshabilitado,
#                cookie segura (ver el aviso de FINMIND_COOKIE_SEGURA).
#   prod,google  la combinacion de la demostracion final.
SPRING_PROFILES_ACTIVE=

# ---------------------------------------------------------------------------
# CAPTCHA — Cloudflare Turnstile (RF-031, RN-016, ADR-011)
# ---------------------------------------------------------------------------
# Con CAPTCHA_ENABLED=false se omite la verificacion.
#
# OJO: hoy viene en false, y eso significa que el registro NO TIENE NINGUNA
# proteccion contra registro automatizado. Esta registrado como AME-15 y para
# la demostracion tiene que ir en true.
#
# Como sacar las claves:
#   1. dash.cloudflare.com -> Turnstile -> Add site
#   2. Dominio: localhost      Widget mode: Managed
#   3. Site Key   (publica)  -> va en frontend/.env como VITE_CAPTCHA_SITE_KEY
#   4. Secret Key (secreta)  -> va AQUI, en CAPTCHA_SECRET. No se comparte.
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# ---------------------------------------------------------------------------
# Inicio de sesion con Google (RF-029, RF-030, ADR-009)
# ---------------------------------------------------------------------------
# Como sacar las credenciales:
#   1. console.cloud.google.com -> crear proyecto
#   2. APIs y servicios -> Pantalla de consentimiento de OAuth
#      Tipo: Externo. Agregar tu correo en "Usuarios de prueba", o el acceso
#      queda bloqueado mientras la app no este verificada por Google.
#   3. Credenciales -> Crear credenciales -> ID de cliente de OAuth 2.0
#      Tipo: Aplicacion web
#      URI de redireccionamiento autorizado, EXACTAMENTE ASI:
#        http://localhost:8080/login/oauth2/code/google
#      Ese es el del BACKEND, no el del frontend. Si se pone el del 5173,
#      Google responde redirect_uri_mismatch.
#   4. Copiar el ID y el secreto aqui abajo.
#   5. Poner "google" en SPRING_PROFILES_ACTIVE mas arriba.
#   6. En frontend/.env poner VITE_GOOGLE_HABILITADO=true.
#
# Si no se activa el perfil google, el acceso con Google queda apagado y el
# resto de la aplicacion funciona igual: el bean no se crea y SecurityConfig
# lo detecta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A donde vuelve el navegador tras autenticarse con Google. Desde SEG-08 la
# URL de retorno NO lleva el token: la sesion se abre con Set-Cookie.
OAUTH2_SUCCESS_URL=http://localhost:5173/oauth2/callback
OAUTH2_ERROR_URL=http://localhost:5173/iniciar-sesion

# ---------------------------------------------------------------------------
# Topes de intentos (SEG-03, SEG-04, SEG-05)
# ---------------------------------------------------------------------------
# Estas seis las lee application.yml y NO estaban documentadas aqui. Todas
# tienen valor por defecto, asi que la aplicacion funciona sin definirlas: se
# dejan comentadas y solo se descomentan para ajustar los topes.
#
# Van comentadas a proposito. Bajarlas de mas puede dejar fuera a un usuario
# legitimo que se equivoco tres veces; subirlas de mas anula la proteccion.

# Tope de intentos de inicio de sesion, por correo y por IP, y su ventana.
# Se limita por las dos vias: por correo frena probar mil contrasenas sobre una
# cuenta, y por IP frena probar una contrasena sobre mil cuentas.
# LOGIN_MAX_POR_CORREO=5
# LOGIN_MAX_POR_IP=20
# LOGIN_VENTANA_MINUTOS=15

# Tope de EMISION de codigos de verificacion y recuperacion. El tope de cinco
# intentos por codigo no servia de nada mientras se pudiera pedir un codigo
# nuevo sin freno: limitando la emision quedan 25 combinaciones por hora de un
# millon posibles.
# CODIGO_MAX_ENVIOS=5
# CODIGO_VENTANA_ENVIOS=60

# Separacion minima entre dos envios seguidos, en segundos. Sin esto los cinco
# de la hora se gastan en un segundo y se puede llenar de correos la bandeja
# de cualquiera.
# CODIGO_INTERVALO_MINIMO=60
