# Copiar a .env y completar. El archivo .env NO se sube al repositorio (ARQ-03, SEG-02).
# ---------------------------------------------------------------------------
# OPCION A — Neon, PostgreSQL en la nube (es la que se demuestra)
# ---------------------------------------------------------------------------
# El host lo da el panel de Neon: ep-algo-123456.REGION.aws.neon.tech
# sslmode=require es obligatorio, Neon rechaza conexiones sin TLS.
DB_URL=jdbc:postgresql://HOST.neon.tech/finmind?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# OPCION B — PostgreSQL local con Docker (para desarrollar sin internet)
# ---------------------------------------------------------------------------
# DB_URL=jdbc:postgresql://localhost:5433/finmind
# DB_USERNAME=finmind_user
# DB_PASSWORD=finmind_local

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Minimo 32 caracteres aleatorios. Generar con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# ---------------------------------------------------------------------------
# Correo saliente - codigos de verificacion y recuperacion
# ---------------------------------------------------------------------------
# MAIL_ENABLED=false envia el codigo al log en vez de por correo.
# Util para demostrar el flujo sin depender del servidor de correo.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
# Contrasena de aplicacion de 16 caracteres, SIN espacios. No es la del correo.
MAIL_PASSWORD=
MAIL_FROM=FinMind <tu_correo@gmail.com>

# Origenes permitidos para el frontend de Luis (SEG-08)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Perfil activo: vacio para desarrollo, "prod" para la demostracion
SPRING_PROFILES_ACTIVE=

# CAPTCHA. Con CAPTCHA_ENABLED=false se omite la verificacion en desarrollo.
# La clave secreta se saca del panel del proveedor y NO se comparte.
CAPTCHA_ENABLED=false
CAPTCHA_SECRET=
CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Inicio de sesion con Google. Se obtienen en Google Cloud Console ->
# APIs y servicios -> Credenciales -> ID de cliente de OAuth 2.0.
# Si quedan vacias, la aplicacion arranca igual y solo se deshabilita
# el boton de Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH2_SUCCESS_URL=http://localhost:5173/oauth2/callback
