# Copiar a .env y completar. El archivo .env NO se sube al repositorio (ARQ-03, SEG-02).
# ---------------------------------------------------------------------------
# OPCION A — Base de datos en la nube (recomendada, es la que se demuestra)
# ---------------------------------------------------------------------------
# Reemplazar host, puerto y credenciales con los del panel del proveedor.
# El puerto NO es 3306: los proveedores gestionados asignan uno propio.
# sslMode=REQUIRED es obligatorio, el proveedor rechaza conexiones sin TLS.
DB_URL=jdbc:mysql://HOST:PUERTO/finmind?sslMode=REQUIRED&serverTimezone=America/Bogota&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=finmind_app
DB_PASSWORD=

# ---------------------------------------------------------------------------
# OPCION B — MySQL local (para desarrollar sin internet)
# ---------------------------------------------------------------------------
# DB_URL=jdbc:mysql://localhost:3306/finmind?useSSL=false&serverTimezone=America/Bogota
# DB_USERNAME=finmind_user
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Minimo 32 caracteres aleatorios. Generar con:
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# Origenes permitidos para el frontend de Luis (SEG-08)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Perfil activo: vacio para desarrollo, "prod" para la demostracion
SPRING_PROFILES_ACTIVE=
