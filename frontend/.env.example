# URL base de la API. En desarrollo el backend corre en el 8080.
VITE_API_URL=http://localhost:8080/api/v1

# Clave PUBLICA del CAPTCHA (Cloudflare Turnstile).
# Se obtiene en dash.cloudflare.com -> Turnstile -> Add site.
# Si se deja vacia, el widget no se muestra y el registro sigue funcionando:
# util en desarrollo, cuando el backend tambien lo tiene deshabilitado.
# La clave SECRETA no va aqui: vive solo en el .env del backend.
VITE_CAPTCHA_SITE_KEY=

# Acceso con Google. Ponlo en true SOLO cuando el backend tenga las credenciales
# y arranque con SPRING_PROFILES_ACTIVE=google. Si no, el boton se oculta:
# mostrar un boton que siempre falla es peor que no mostrarlo.
VITE_GOOGLE_HABILITADO=false
